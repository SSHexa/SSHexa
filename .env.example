# SSHexa Demo Environment Variables

# OOD Portal URL - where users are redirected for authentication
# Must be the public hostname (NOT a raw IP) so the TLS certificate matches
# and the OIDC/Dex flow completes on a single origin. Using the raw IP causes
# a 400 Bad Request on /dex/auth/local/login due to state-cookie origin split.
REACT_APP_OOD_URL=https://practicloud-ood.eastus2.cloudapp.azure.com
